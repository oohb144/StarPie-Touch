<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WinPieGestures.RadialWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RadialWindow" Height="360" Width="360" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual" ShowActivated="False" Focusable="False" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified" RenderOptions.ClearTypeHint="Enabled" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed" xmlns:winpiegestures="clr-namespace:WinPieGestures;assembly=StarPie">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DropShadowEffect x:Key="RadialShadow" Color="#000000" BlurRadius="28" ShadowDepth="2" Opacity="0.45" />
      <DropShadowEffect x:Key="TextShadow" Color="#000000" BlurRadius="1.5" ShadowDepth="0.8" Opacity="0.4" />
      <DropShadowEffect x:Key="NeonGlowEffect" Color="#06B6D4" BlurRadius="22" ShadowDepth="0" Opacity="0.85" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainGrid" RenderTransformOrigin="0.5,0.5">
    <UIElement.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="WindowScale" ScaleX="0.5" ScaleY="0.5" />
        <SkewTransform />
        <RotateTransform />
        <TranslateTransform />
      </TransformGroup>
    </UIElement.RenderTransform>
    <Ellipse Name="OuterEllipse" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.5">
      <Shape.Stroke>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#40FFFFFF" Offset="0" />
          <GradientStop Color="#10FFFFFF" Offset="0.5" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Shape.Stroke>
    </Ellipse>
    <Canvas Name="WheelCanvas" Width="340" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid Name="CoreGrid" RenderTransformOrigin="0.5,0.5">
        <UIElement.RenderTransform>
          <ScaleTransform x:Name="CoreScale" ScaleX="1.0" ScaleY="1.0" />
        </UIElement.RenderTransform>
        <Ellipse Name="CoreEllipse" Fill="#E0111115" Stroke="#30FFFFFF" StrokeThickness="1.2" />
        <Ellipse Margin="2">
          <Shape.Fill>
            <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.5" RadiusY="0.5">
              <GradientStop Color="#20FFFFFF" Offset="0" />
              <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
          </Shape.Fill>
        </Ellipse>
        <StackPanel Name="CoreTextPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5">
          <TextBlock Name="CoreTitle" Text="WinPie" Foreground="#D0FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <TextBlock Name="CoreSubtitle" Text="RMB Drag" Foreground="#80FFFFFF" FontSize="8" HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>
        <Path Name="CoreExitIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 L19,6.41" />
        <Ellipse Name="CoreCustomImageEllipse" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified" />
        <Ellipse Name="CoreSelectionOverlay" Fill="#70273045" Opacity="0.92" Stroke="#80FFFFFF" StrokeThickness="1.1" Visibility="Collapsed" IsHitTestVisible="False">
          <Ellipse.Effect>
            <BlurEffect Radius="7" RenderingBias="Performance" />
          </Ellipse.Effect>
        </Ellipse>
        <StackPanel Name="CoreSelectionTextPanel" Width="150" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock Name="CoreSelectionText" Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54" Effect="{StaticResource TextShadow}" />
        </StackPanel>
        <TextBlock Name="CoreVolumeText" Text="🔊 50%" Foreground="#FFFFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" Margin="6" Visibility="Collapsed" IsHitTestVisible="False" Effect="{StaticResource TextShadow}" />
      </Grid>
    </Canvas>
    <!-- 多层轮盘切换时的层级提示浮动微标 -->
    <Border Name="LayerIndicatorBadge" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Background="#E60F172A" BorderBrush="#38BDF8" BorderThickness="1.2" CornerRadius="12" Padding="12,4" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Color="#000000" Opacity="0.5" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Name="LayerIndicatorIcon" Text="🌟" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
        <TextBlock Name="LayerIndicatorText" Text="第 1 层 (1/1)" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
